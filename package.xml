<?xml version="1.0"?>
<package format="2">
  <name>imitation_utils</name>
  <version>0.0.1</version>
  <description>Imitation Learning using Lerobot for ROS1 robots</description>

  <maintainer email="tsubaki@jsk.t.u-tokyo.ac.jp">Michitoshi Tsubaki</maintainer>
  
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>catkin_virtualenv</depend>
  <depend>rospy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  
  <export>
    <pip_requirements>requirements.txt</pip_requirements>
  </export>

</package>
